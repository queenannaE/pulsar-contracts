HORIZON_URL=https://horizon-testnet.stellar.org
CONTRACT_ID=YOUR_CONTRACT_ID_HERE
DATABASE_URL=postgresql://user:password@localhost:5432/pulsar_events
PORT=3001
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Ledger to start backfilling from on first run (when the events table is
# empty). Without this, the indexer would start at ledger 1 and either
# error out (ledger too old for RPC retention) or silently miss every event
# emitted before the service's first start. Leave unset to start from the
# current/latest ledger instead (no backfill).
START_LEDGER=
